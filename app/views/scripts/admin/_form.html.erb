<%= render EnterpriseEdition::BannerComponent.new(:running_scripts, variant: :inline) %>

<fieldset class="form--fieldset">
  <p>
    <%= t "scripts.form.introduction" %>
  </p>

  <div class="form--field -required">
    <%= f.text_field :name, required: true, container_class: "-middle" %>
  </div>

  <div class="form--field">
    <%= f.text_area :description, container_class: "-wide" %>
  </div>

  <div class="form--field -required">
    <%= f.text_area :text, rows: 25, container_class: "-wide", required: true %>
    <div class="form--field-instructions">
      <%= t("scripts.form.text.description") %>
    </div>
  </div>

  <div class="form--field">
    <%= f.check_box :enabled %>
    <div class="form--field-instructions">
      <%= t("scripts.form.enabled.description") %>
    </div>
  </div>
</fieldset>

<fieldset class="form--fieldset">
  <legend class="form--fieldset-legend">
    <%= t "scripts.form.run_as.title" %>
  </legend>
  <div class="form--field">
    <%= f.radio_button :run_as,
                       "current_user",
                       label: t("scripts.form.run_as.current_user"),
                       container_class: "-wide" %>
  </div>
  <div class="form--field">
    <%= f.radio_button :run_as,
                       "system_user",
                       label: t("scripts.form.run_as.system_user"),
                       container_class: "-wide" %>
  </div>
</fieldset>

<fieldset
  class="form--fieldset"
  id="scripts-selected-events"
  data-controller="checkable">
  <legend class="form--fieldset-legend">
      <%= t "scripts.form.events.title" %>
  </legend>
  <div class="form--toolbar">
    <span class="form--toolbar-item">
      <%= check_all_links %>
    </span>
  </div>

  <% event_names = @script.event_names %>
  <% OpenProject::Scripts::EventResources.available_events_map.each do |resource_label, events| %>
    <div class="form--field">
      <label class="form--label"><%= resource_label %></label>
      <div class="form--field-container -vertical">
        <% events.each do |key, label| %>
          <label class="form--label-with-check-box">
            <%=
              styled_check_box_tag(
                "script[events][]",
                key,
                event_names.include?(key),
                data: {
                  checkable_target: "checkbox"
                }
              )
            -%>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
</fieldset>

<fieldset class="form--fieldset" data-controller="disable-when-value-selected">
  <legend class="form--fieldset-legend">
    <%= t "scripts.form.project_ids.title" %>
  </legend>
  <p><%= t("scripts.form.project_ids.description") %></p>
  <div class="form--field">
      <%= f.radio_button :project_ids,
                         "all",
                         checked: @script.all_projects?,
                         label: t("scripts.form.project_ids.all"),
                         container_class: "-wide",
                         data: {
                           disable_when_value_selected_target: "cause",
                           target_name: "script_project_ids"
                         } %>
  </div>
  <div class="form--field">
      <%= f.radio_button :project_ids,
                         "selection",
                         checked: !@script.all_projects?,
                         label: t("scripts.form.project_ids.selected"),
                         container_class: "-wide",
                         data: {
                           disable_when_value_selected_target: "cause",
                           target_name: "script_project_ids"
                         } %>
  </div>

  <div class="form--field">
    <label class="form--label"><%= t "scripts.form.selected_project_ids.title" %></label>
    <div class="form--field-container -vertical">
      <% Project.pluck(:id, :name).each do |id, name| %>
        <label class="form--label-with-check-box">
          <%= styled_check_box_tag "script[selected_project_ids][]",
                                   id,
                                   !@script.all_projects? && @script.project_ids.include?(id),
                                   disabled: @script.all_projects?,
                                   class: "scripts--selected-project-ids",
                                   data: {
                                     disable_when_value_selected_target: "effect",
                                     target_name: "script_project_ids",
                                     value: "selection"
                                   } -%>
          <%= name %>
        </label>
      <% end %>
    </div>
  </div>
</fieldset>

<% unless @script.new_record? %>
  <%= f.hidden_field :lock_version %>
<% end %>
