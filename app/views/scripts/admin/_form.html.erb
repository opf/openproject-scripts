<%= render EnterpriseEdition::BannerComponent.new(:running_scripts, variant: :inline) %>

<div class="form--field-container -vertical">
  <p><%= t "scripts.form.introduction" %></p>
</div>

<%= primer_form_with(
      model: @script,
      url: url,
      method: method,
      html: { autocomplete: "off" }
    ) do |f| %>
  <%= render Scripts::ScriptForm.new(f) %>
<% end %>
