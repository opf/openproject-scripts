<% html_title t(:label_administration), t("scripts.plural"), @script.name %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { @script.name }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t("label_administration") },
       { href: admin_settings_api_path, text: t("menus.admin.api_and_webhooks") },
       { href: admin_scripts_path, text: t("scripts.plural") },
       @script.name]
    )
  end
%>

<%= error_messages_for @script %>

<%= labelled_tabular_form_for @script,
                              url: { action: :update },
                              as: "script",
                              html: { class: "form", autocomplete: "off" } do |f| %>
  <%= render partial: "form", locals: { f: f, script: @script } %>
  <p>
    <%= styled_button_tag t(:button_save), class: "-primary -with-icon icon-checkmark" %>
    <%= link_to t(:button_cancel), { action: :index }, class: "button -with-icon icon-cancel" %>
  </p>
<% end %>
